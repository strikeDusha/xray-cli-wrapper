def xray_bin() -> str | None:
    return shutil.which("xray")


def xray_version() -> str | None:
    b = xray_bin()
    if not b:
        return None
    try:
        out = subprocess.run([b, "version"], capture_output=True, text=True, timeout=5)
        return out.stdout.strip().splitlines()[0] if out.stdout else None
    except Exception:
        return None


def require_xray() -> bool:
    if xray_bin():
        return True
    err("xray binary not found.")
    print(box([
        f"Install on Arch with one of:",
        f"  {CYAN}sudo pacman -S xray{RESET}        {DIM}(community repo){RESET}",
        f"  {CYAN}yay -S xray-bin{RESET}            {DIM}(AUR){RESET}",
    ], title="xray not installed", color=YELLOW))
    return False


# --------------------------------------------------------------------------- #
# systemd --user
# --------------------------------------------------------------------------- #
def _have_systemd() -> bool:
    return shutil.which("systemctl") is not None


def _systemctl(*args, capture=False):
    return subprocess.run(["systemctl", "--user", *args],
                          capture_output=capture, text=True)


def write_unit():
    os.makedirs(SYSTEMD_USER_DIR, exist_ok=True)
    unit = f"""[Unit]
Description=xray-cli managed Xray-core instance
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={xray_bin() or '/usr/bin/xray'} run -config {GEN_CONFIG}
Restart=on-failure
RestartSec=3
LimitNOFILE=51200

[Install]
WantedBy=default.target
"""
    with open(UNIT_PATH, "w") as f:
        f.write(unit)
    if _have_systemd():
        _systemctl("daemon-reload")


def service_active() -> bool:
    if not _have_systemd():
        return False
    r = _systemctl("is-active", UNIT_NAME, capture=True)
    return r.stdout.strip() == "active"


# --------------------------------------------------------------------------- #
# TUN mode  (transparent / whole-system tunnel via tun2socks)
# --------------------------------------------------------------------------- #
# Approach mirrors v2rayN / NekoBox / sing-box on Linux:
#   1. A TUN device (tun0, 198.18.0.1/15) captures all traffic.
#   2. tun2socks forwards that traffic to our local SOCKS inbound (xray).
#   3. A /32 bypass route sends xray's own connection to the proxy server out
#      the real interface, so it doesn't loop back into the tunnel.
#   4. 0.0.0.0/1 + 128.0.0.0/1 "split default" routes win over the real default
#      without deleting it, so teardown is clean.
# Everything that touches the kernel runs as one batched `sudo sh -c` so the
# user is prompted for a password at most once.
TUN_DEV = "tun0"
TUN_ADDR = "198.18.0.1/15"
TUN_UNIT = "xray-cli-tun"


def tun2socks_bin() -> str | None:
    return shutil.which("tun2socks")


def default_route() -> tuple[str | None, str | None]:
    """Return (interface, gateway) for the current IPv4 default route."""
    if not shutil.which("ip"):
        return None, None
    try:
        out = subprocess.run(["ip", "route", "show", "default"],
                             capture_output=True, text=True, timeout=4).stdout
    except Exception:
        return None, None
    # e.g. "default via 192.168.1.1 dev wlan0 proto dhcp metric 600"
    m = re.search(r"default(?:\s+via\s+(\S+))?\s+dev\s+(\S+)", out)
    if not m:
        return None, None
    return m.group(2), m.group(1)


def resolve_ips(host: str) -> list[str]:
    """Resolve a host to IPv4 addresses (skip the tun subnet itself)."""
    ips = set()
    try:
        for fam, *_ , sa in socket.getaddrinfo(host, None, socket.AF_INET):
            ips.add(sa[0])
    except Exception:
        pass
    return sorted(ips)


def load_tun_state() -> dict:
    try:
        with open(TUN_STATE_FILE) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def tun_active() -> bool:
    if not _have_systemd():
        return False
    r = subprocess.run(["systemctl", "is-active", TUN_UNIT],
                       capture_output=True, text=True)
    return r.stdout.strip() == "active"


def _run_root_script(script: str) -> int:
    """Run a shell script as root via one sudo prompt."""
    print(f"  {DIM}(requesting root via sudo for network setup…){RESET}")
    return subprocess.run(["sudo", "sh", "-c", script]).returncode


# --------------------------------------------------------------------------- #
# Latency test (TCP connect time to server endpoint)
# --------------------------------------------------------------------------- #
def tcp_latency(host: str, port: int, timeout=3.0) -> float | None:
    try:
        start = time.perf_counter()
        with socket.create_connection((host, port), timeout=timeout):
            return (time.perf_counter() - start) * 1000.0
    except Exception:
        return None


# --------------------------------------------------------------------------- #
# Subscription fetch
# --------------------------------------------------------------------------- #
def fetch_subscription(url: str) -> list[str]:
    req = urllib.request.Request(url, headers={"User-Agent": "xray-cli/1.0"})
    with urllib.request.urlopen(req, timeout=15) as r:
        body = r.read()
    text = body.decode("utf-8", "replace").strip()
    # subscription bodies are usually base64 of newline-joined links
    try:
        decoded = _b64decode(text).decode("utf-8", "replace")
        if "://" in decoded:
            text = decoded
    except Exception:
        pass
    return [ln.strip() for ln in text.splitlines() if "://" in ln]


# --------------------------------------------------------------------------- #
# System proxy
# --------------------------------------------------------------------------- #
ENV_PROXY_FILE = os.path.join(CONFIG_DIR, "proxy.env")


def _gsettings(*args) -> bool:
    if not shutil.which("gsettings"):
        return False
    try:
        subprocess.run(["gsettings", *args], check=True, capture_output=True)
        return True
    except Exception:
        return False


def proxy_on(state):
    host = state.get("listen", "127.0.0.1")
    hp = state["http_port"]
    sp = state["socks_port"]
    _ensure_dirs()
    with open(ENV_PROXY_FILE, "w") as f:
        f.write(f"export http_proxy=http://{host}:{hp}\n"
                f"export https_proxy=http://{host}:{hp}\n"
                f"export all_proxy=socks5://{host}:{sp}\n"
                f"export HTTP_PROXY=http://{host}:{hp}\n"
                f"export HTTPS_PROXY=http://{host}:{hp}\n"
                f"export ALL_PROXY=socks5://{host}:{sp}\n")
    g = False
    if _gsettings("set", "org.gnome.system.proxy", "mode", "manual"):
        _gsettings("set", "org.gnome.system.proxy.http", "host", host)
        _gsettings("set", "org.gnome.system.proxy.http", "port", str(hp))
        _gsettings("set", "org.gnome.system.proxy.https", "host", host)
        _gsettings("set", "org.gnome.system.proxy.https", "port", str(hp))
        _gsettings("set", "org.gnome.system.proxy.socks", "host", host)
        _gsettings("set", "org.gnome.system.proxy.socks", "port", str(sp))
        g = True
    return g


def proxy_off():
    g = _gsettings("set", "org.gnome.system.proxy", "mode", "none")
    try:
        os.remove(ENV_PROXY_FILE)
    except FileNotFoundError:
        pass
    return g


