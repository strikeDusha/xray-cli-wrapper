def build_parser():
    p = argparse.ArgumentParser(prog="xr", description="Friendly Xray-core CLI wrapper")
    sub = p.add_subparsers(dest="cmd")
    sp = sub.add_parser("add", help="add share link(s)")
    sp.add_argument("links", nargs="+")
    sub.add_parser("list", help="list servers")
    sp = sub.add_parser("use", help="set active server")
    sp.add_argument("ref")
    sp = sub.add_parser("remove", help="remove a server")
    sp.add_argument("ref")
    sub.add_parser("start", help="start proxy")
    sub.add_parser("stop", help="stop proxy")
    sub.add_parser("restart", help="restart proxy")
    sub.add_parser("status", help="show status")
    sub.add_parser("test", help="latency test")
    sub.add_parser("fastest", help="switch to fastest server")
    sp = sub.add_parser("sub", help="import subscription URL")
    sp.add_argument("url")
    sp = sub.add_parser("proxy", help="system proxy on|off")
    sp.add_argument("action", choices=["on", "off"])
    tp = sub.add_parser("tun", help="whole-system TUN tunnel on|off|status")
    tp.add_argument("action", choices=["on", "off", "status"], nargs="?", default="status")
    lp = sub.add_parser("logs", help="show service logs")
    lp.add_argument("-f", "--follow", action="store_true")
    sub.add_parser("config", help="print generated xray config")
    sub.add_parser("install-unit", help="(re)write the systemd user unit")
    return p


def main(argv=None):
    argv = argv if argv is not None else sys.argv[1:]
    if not argv:
        repl()
        return
    args = build_parser().parse_args(argv)
    dispatch = {
        "add": lambda: cmd_add(args.links),
        "list": cmd_list,
        "use": lambda: cmd_use(args.ref),
        "remove": lambda: cmd_remove(args.ref),
        "start": cmd_start,
        "stop": cmd_stop,
        "restart": cmd_restart,
        "status": cmd_status,
        "test": lambda: cmd_test(switch=False),
        "fastest": lambda: cmd_test(switch=True),
        "sub": lambda: cmd_sub(args.url),
        "proxy": lambda: cmd_proxy(args.action),
        "tun": lambda: cmd_tun(args.action),
        "logs": lambda: cmd_logs(follow=args.follow),
        "config": cmd_config,
        "install-unit": write_unit,
    }
    fn = dispatch.get(args.cmd)
    if fn:
        fn()
    else:
        repl()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        sys.exit(130)
