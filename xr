def _tun_on():
    # 0. preconditions
    if not require_xray():
        return
    if not tun2socks_bin():
        err("tun2socks binary not found.")
        print(box([
            "TUN mode needs tun2socks (xjasonlyu). Install on Arch:",
            f"  {CYAN}yay -S tun2socks{RESET}            {DIM}(AUR){RESET}",
            f"  {CYAN}yay -S hev-socks5-tunnel{RESET}    {DIM}(alt, different binary){RESET}",
        ], title="tun2socks not installed", color=YELLOW))
        return
    if not _have_systemd() or not shutil.which("ip"):
        err("TUN mode requires systemd + iproute2 (Arch has both); not available here.")
        return
    state = load_state()
    servers = load_servers()
    server = next((s for s in servers if s["tag"] == state.get("active")), None)
    if not server:
        err("no active server — pick one with `xr use <name>`")
        return

    iface, gw = default_route()
    if not iface or not gw:
        err("could not detect the default route / gateway; is the network up?")
        return

    # 1. Resolve the server to literal IPs *now*, while routing is still normal.
    #    We pin xray to one of these IPs so it can never dial an address that
    #    isn't in our bypass set (that would create a routing loop).
    with Spinner(f"resolving {server['address']}"):
        bypass = [server["address"]] if _is_ip(server["address"]) else resolve_ips(server["address"])
    if not bypass:
        err(f"could not resolve {server['address']} to an IPv4 address — "
            "cannot establish a leak-free tunnel. Aborting.")
        return
    pin_ip = bypass[0]

    # 2. (Re)write the pinned config and (re)start xray under it.
    prev_bypass = load_tun_state().get("bypass", []) if tun_active() else []
    write_active_config(servers, state, pin_ip=pin_ip)
    write_unit()
    with Spinner(f"starting xray (pinned to {pin_ip})"):
        _systemctl("restart", UNIT_NAME, capture=True)
        time.sleep(0.7)
    if not service_active():
        err("xray failed to start with the pinned config — check `xr logs`")
        write_active_config(servers, state)  # restore unpinned
        _systemctl("restart", UNIT_NAME, capture=True)
        return

    socks = state["socks_port"]
    t2s = tun2socks_bin()
    all_bypass = sorted(set(bypass) | set(prev_bypass))
    bypass_cmds = "\n".join(
        f"ip route replace {ip}/32 via {gw} dev {iface}" for ip in all_bypass)

    # 3. Kernel setup — one batched sudo. Fail-closed: split routes point at the
    #    tun, so if tun2socks dies traffic is dropped, not leaked.
    script = f"""set -e
# --- tun device ---
ip tuntap add mode tun dev {TUN_DEV} 2>/dev/null || true
ip addr replace {TUN_ADDR} dev {TUN_DEV}
ip link set dev {TUN_DEV} mtu 1500 up
# --- relax reverse-path filtering so tun packets aren't dropped ---
sysctl -wq net.ipv4.conf.all.rp_filter=0 2>/dev/null || true
sysctl -wq net.ipv4.conf.{iface}.rp_filter=0 2>/dev/null || true
sysctl -wq net.ipv4.conf.{TUN_DEV}.rp_filter=0 2>/dev/null || true
# --- bypass: the proxy server stays reachable directly (no loop) ---
{bypass_cmds}
# --- split default into the tun (wins over the real default, leaves it intact) ---
ip route replace 0.0.0.0/1 dev {TUN_DEV}
ip route replace 128.0.0.0/1 dev {TUN_DEV}
# --- IPv6 kill-switch: blackhole all v6 so it can't leak around the v4 tunnel ---
ip -6 route replace blackhole ::/1 2>/dev/null || true
ip -6 route replace blackhole 8000::/1 2>/dev/null || true
# --- run tun2socks as a transient root service, auto-restarting (journald) ---
systemctl reset-failed {TUN_UNIT} 2>/dev/null || true
systemctl stop {TUN_UNIT} 2>/dev/null || true
systemd-run --unit={TUN_UNIT} --collect \\
    --property=Restart=always --property=RestartSec=2 \\
    {t2s} -device {TUN_DEV} -proxy socks5://127.0.0.1:{socks} -interface {iface} \\
    -loglevel warning
# --- DNS through the tunnel; preserve a resolv.conf symlink if there is one ---
if [ ! -e /etc/resolv.conf.xrbak ] && [ ! -L /etc/resolv.conf.xrbak ]; then
    cp -P /etc/resolv.conf /etc/resolv.conf.xrbak 2>/dev/null || true
fi
rm -f /etc/resolv.conf
printf 'nameserver 1.1.1.1\\nnameserver 8.8.8.8\\noptions edns0\\n' > /etc/resolv.conf
"""
    with Spinner("configuring tun device, routes + kill-switch (sudo)"):
        rc = _run_root_script(script)
    if rc != 0:
        err("tun setup failed (see errors above) — rolling back")
        _tun_off(silent=True)
        return

    _ensure_dirs()
    with open(TUN_STATE_FILE, "w") as f:
        json.dump({"dev": TUN_DEV, "bypass": all_bypass, "iface": iface, "gw": gw,
                   "pin_ip": pin_ip, "server": server["tag"], "ipv6_blocked": True},
                  f, indent=2)

    # 4. Verify the device + service actually came up; otherwise roll back.
    time.sleep(0.6)
    if not tun_active():
        err("tun2socks did not come up — rolling back. "
            "Check `journalctl -u xray-cli-tun`")
        _tun_off(silent=True)
        return

    # 5. Prove it: fetch our exit IP through xray's socks, and again over the
    #    plain OS path (which must traverse the tun). Matching IPs = leak-free.
    with Spinner("verifying tunnel (exit IP)"):
        via_socks = egress_ip_via_socks(state)
        via_os = egress_ip_via_os()

    ok(f"TUN mode {style('ON', GREEN, BOLD)} — whole system routed via "
       f"{style(server['tag'], BOLD)} {DIM}(pinned {pin_ip}){RESET}")
    if via_socks and via_os and via_socks == via_os:
        ok(f"verified: exit IP {style(via_os, BOLD, GREEN)} via tunnel "
           f"{DIM}(socks & OS path agree — no leak){RESET}")
    elif via_os:
        warn(f"OS path exits via {style(via_os, BOLD)} "
             f"{DIM}(socks reported {via_socks or '—'}; tunnel up but verify with `xr tun status`){RESET}")
    elif via_socks:
        warn(f"proxy core works (exit {via_socks}) but the OS-path check failed — "
             "the IP-echo host may be unreachable; tunnel routes are in place")
    else:
        warn("could not confirm exit IP (echo host unreachable). Device + routes "
             "are up and fail-closed; check `xr logs` / `xr tun status`")
    info("kill-switch active: if the tunnel drops, traffic is blocked (not leaked). "
         "Turn off with `xr tun off`")


def _tun_off(silent=False):
    if not shutil.which("ip"):
        if not silent:
            warn("iproute2 not available")
        return
    st = load_tun_state()
    bypass = st.get("bypass", [])
    bypass_cmds = "\n".join(f"ip route del {ip}/32 2>/dev/null || true" for ip in bypass)
    script = f"""set +e
systemctl stop {TUN_UNIT} 2>/dev/null
systemctl reset-failed {TUN_UNIT} 2>/dev/null
ip route del 0.0.0.0/1 dev {TUN_DEV} 2>/dev/null
ip route del 128.0.0.0/1 dev {TUN_DEV} 2>/dev/null
ip -6 route del blackhole ::/1 2>/dev/null
ip -6 route del blackhole 8000::/1 2>/dev/null
{bypass_cmds}
ip link set dev {TUN_DEV} down 2>/dev/null
ip tuntap del mode tun dev {TUN_DEV} 2>/dev/null
if [ -e /etc/resolv.conf.xrbak ] || [ -L /etc/resolv.conf.xrbak ]; then
    rm -f /etc/resolv.conf
    cp -P /etc/resolv.conf.xrbak /etc/resolv.conf 2>/dev/null
    rm -f /etc/resolv.conf.xrbak
fi
true
"""
    with Spinner("tearing down tun, routes + kill-switch (sudo)"):
        _run_root_script(script)
    try:
        os.remove(TUN_STATE_FILE)
    except FileNotFoundError:
        pass
    # restore the normal (unpinned) xray config so direct proxy use still works
    servers, state = load_servers(), load_state()
    if state.get("active"):
        write_active_config(servers, state)
        if service_active():
            _systemctl("restart", UNIT_NAME, capture=True)
    if not silent:
        ok(f"TUN mode {style('OFF', RED, BOLD)} — routing, DNS & IPv6 restored")


