def _have_systemd() -> bool:
    return shutil.which("systemctl") is not None


def _systemctl(*args, capture=False):
    return subprocess.run(["systemctl", "--user", *args],
                          capture_output=capture, text=True)


def write_unit():
    os.makedirs(SYSTEMD_USER_DIR, exist_ok=True)
    unit = f"""[Unit]
Description=xray-cli managed Xray-core instance
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={xray_bin() or '/usr/bin/xray'} run -config {GEN_CONFIG}
Restart=on-failure
RestartSec=3
LimitNOFILE=51200

[Install]
WantedBy=default.target
"""
    with open(UNIT_PATH, "w") as f:
        f.write(unit)
    if _have_systemd():
        _systemctl("daemon-reload")


def service_active() -> bool:
    if not _have_systemd():
        return False
    r = _systemctl("is-active", UNIT_NAME, capture=True)
    return r.stdout.strip() == "active"


# --------------------------------------------------------------------------- #
# TUN mode  (transparent / whole-system tunnel via tun2socks)
# --------------------------------------------------------------------------- #
# Approach mirrors v2rayN / NekoBox / sing-box on Linux:
#   1. A TUN device (tun0, 198.18.0.1/15) captures all traffic.
#   2. tun2socks forwards that traffic to our local SOCKS inbound (xray).
#   3. A /32 bypass route sends xray's own connection to the proxy server out
#      the real interface, so it doesn't loop back into the tunnel.
#   4. 0.0.0.0/1 + 128.0.0.0/1 "split default" routes win over the real default
#      without deleting it, so teardown is clean.
# Everything that touches the kernel runs as one batched `sudo sh -c` so the
# user is prompted for a password at most once.
TUN_DEV = "tun0"
TUN_ADDR = "198.18.0.1/15"
TUN_UNIT = "xray-cli-tun"


def tun2socks_bin() -> str | None:
    return shutil.which("tun2socks")


def default_route() -> tuple[str | None, str | None]:
    """Return (interface, gateway) for the current IPv4 default route."""
    if not shutil.which("ip"):
        return None, None
    try:
        out = subprocess.run(["ip", "route", "show", "default"],
                             capture_output=True, text=True, timeout=4).stdout
    except Exception:
        return None, None
    # e.g. "default via 192.168.1.1 dev wlan0 proto dhcp metric 600"
    m = re.search(r"default(?:\s+via\s+(\S+))?\s+dev\s+(\S+)", out)
    if not m:
        return None, None
    return m.group(2), m.group(1)


def resolve_ips(host: str) -> list[str]:
    """Resolve a host to IPv4 addresses (skip the tun subnet itself)."""
    ips = set()
    try:
        for fam, *_ , sa in socket.getaddrinfo(host, None, socket.AF_INET):
            ips.add(sa[0])
    except Exception:
        pass
    return sorted(ips)


def load_tun_state() -> dict:
