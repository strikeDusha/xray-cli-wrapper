# --- connectivity verification -------------------------------------------- #
IP_ECHO_HOST = "api.ipify.org"  # plain-HTTP IP echo, reachable from the exit node


def _recvn(sock, n):
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise OSError("connection closed mid-read")
        buf += chunk
    return buf


def _socks5_connect(proxy_host, proxy_port, dest_host, dest_port, timeout=8.0):
    s = socket.create_connection((proxy_host, proxy_port), timeout)
    s.settimeout(timeout)
    s.sendall(b"\x05\x01\x00")
    if _recvn(s, 2) != b"\x05\x00":
        s.close()
        raise OSError("socks5 handshake failed")
    h = dest_host.encode()
    s.sendall(b"\x05\x01\x00\x03" + bytes([len(h)]) + h + int(dest_port).to_bytes(2, "big"))
    rep = _recvn(s, 4)
    if rep[1] != 0:
        s.close()
        raise OSError(f"socks5 connect rejected (code {rep[1]})")
    atyp = rep[3]
    if atyp == 1:        # IPv4
        _recvn(s, 4)
    elif atyp == 4:      # IPv6
        _recvn(s, 16)
    elif atyp == 3:      # domain
        _recvn(s, _recvn(s, 1)[0])
    _recvn(s, 2)         # bound port
    return s


def _http_get_ip(sock, host):
    sock.sendall(f"GET / HTTP/1.1\r\nHost: {host}\r\n"
                 f"User-Agent: xray-cli\r\nConnection: close\r\n\r\n".encode())
    data = b""
    try:
        while len(data) < 8192:
            chunk = sock.recv(2048)
            if not chunk:
                break
            data += chunk
    except OSError:
        pass
    finally:
        sock.close()
    body = data.split(b"\r\n\r\n", 1)[-1].decode("utf-8", "replace").strip()
    body = body.splitlines()[-1].strip() if body else ""
    return body if _is_ip(body) else None


def egress_ip_via_socks(state, timeout=8.0):
    """Exit IP as seen by xray's SOCKS inbound (proves the proxy core works)."""
    try:
        s = _socks5_connect(state["listen"], state["socks_port"], IP_ECHO_HOST, 80, timeout)
        return _http_get_ip(s, IP_ECHO_HOST)
    except Exception:
        return None


def egress_ip_via_os(timeout=8.0):
    """Exit IP over the plain OS network path — through the TUN if it's up."""
    try:
        s = socket.create_connection((IP_ECHO_HOST, 80), timeout)
        s.settimeout(timeout)
        return _http_get_ip(s, IP_ECHO_HOST)
    except Exception:
        return None


# --------------------------------------------------------------------------- #
# Latency test (TCP connect time to server endpoint)
# --------------------------------------------------------------------------- #
def tcp_latency(host: str, port: int, timeout=3.0) -> float | None:
    try:
        start = time.perf_counter()
        with socket.create_connection((host, port), timeout=timeout):
            return (time.perf_counter() - start) * 1000.0
    except Exception:
        return None


# --------------------------------------------------------------------------- #
# Subscription fetch
# --------------------------------------------------------------------------- #
def fetch_subscription(url: str) -> list[str]:
    req = urllib.request.Request(url, headers={"User-Agent": "xray-cli/1.0"})
    with urllib.request.urlopen(req, timeout=15) as r:
        body = r.read()
    text = body.decode("utf-8", "replace").strip()
    # subscription bodies are usually base64 of newline-joined links
    try:
        decoded = _b64decode(text).decode("utf-8", "replace")
        if "://" in decoded:
            text = decoded
    except Exception:
        pass
    return [ln.strip() for ln in text.splitlines() if "://" in ln]


