XDG_CONFIG = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
CONFIG_DIR = os.path.join(XDG_CONFIG, APP)
SERVERS_FILE = os.path.join(CONFIG_DIR, "servers.json")
STATE_FILE = os.path.join(CONFIG_DIR, "state.json")
GEN_CONFIG = os.path.join(CONFIG_DIR, "config.json")
SYSTEMD_USER_DIR = os.path.join(XDG_CONFIG, "systemd", "user")
UNIT_NAME = "xray-cli.service"
UNIT_PATH = os.path.join(SYSTEMD_USER_DIR, UNIT_NAME)

