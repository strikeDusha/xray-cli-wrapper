def _tun_status():
    st = load_tun_state()
    on = tun_active()
    dot = f"{GREEN}● on{RESET}" if on else f"{DIM}○ off{RESET}"
    iface, gw = default_route()
    lines = [
        f"{GRAY}tun mode {RESET}{dot}",
        f"{GRAY}device   {RESET}{TUN_DEV}  {DIM}{TUN_ADDR}{RESET}",
        f"{GRAY}via      {RESET}socks5 127.0.0.1:{load_state()['socks_port']} → tun2socks",
        f"{GRAY}bypass   {RESET}{', '.join(st.get('bypass', [])) or DIM + 'none' + RESET}",
        f"{GRAY}uplink   {RESET}{iface or '?'} {DIM}gw {gw or '?'}{RESET}",
    ]
    print(box(lines, title="tun", color=PURPLE))


def _tun_on():
    # 0. preconditions
    if not require_xray():
        return
    if not tun2socks_bin():
        err("tun2socks binary not found.")
        print(box([
            "TUN mode needs tun2socks (xjasonlyu). Install on Arch:",
            f"  {CYAN}yay -S tun2socks{RESET}            {DIM}(AUR){RESET}",
            f"  {CYAN}yay -S hev-socks5-tunnel{RESET}    {DIM}(alt, different binary){RESET}",
        ], title="tun2socks not installed", color=YELLOW))
        return
    if not _have_systemd() or not shutil.which("ip"):
        err("TUN mode requires systemd + iproute2 (Arch has both); not available here.")
        return
    state = load_state()
    servers = load_servers()
    server = next((s for s in servers if s["tag"] == state.get("active")), None)
    if not server:
        err("no active server — pick one with `xr use <name>`")
        return
    if not service_active():
        info("xray service not running — starting it first…")
        cmd_start()
        if not service_active():
            err("could not start xray; aborting tun setup")
            return

    iface, gw = default_route()
    if not iface or not gw:
        err("could not detect the default route / gateway; is the network up?")
        return

    with Spinner(f"resolving {server['address']}") as sp:
        bypass = resolve_ips(server["address"])
    if not bypass:
        warn(f"could not resolve {server['address']} to an IPv4 address — "
             "bypass route may be incomplete (continuing)")

    socks = state["socks_port"]
    t2s = tun2socks_bin()
    bypass_cmds = "\n".join(
        f"ip route replace {ip}/32 via {gw} dev {iface}" for ip in bypass)

    script = f"""set -e
# --- tun device ---
ip tuntap add mode tun dev {TUN_DEV} 2>/dev/null || true
ip addr replace {TUN_ADDR} dev {TUN_DEV}
ip link set dev {TUN_DEV} up
# --- relax reverse-path filtering so tun packets aren't dropped ---
sysctl -wq net.ipv4.conf.all.rp_filter=0 2>/dev/null || true
sysctl -wq net.ipv4.conf.{iface}.rp_filter=0 2>/dev/null || true
# --- bypass: proxy server reachable directly (no loop) ---
{bypass_cmds}
# --- split default into tun (wins over real default, leaves it intact) ---
ip route replace 0.0.0.0/1 dev {TUN_DEV}
ip route replace 128.0.0.0/1 dev {TUN_DEV}
# --- run tun2socks as a transient root service (journald-logged) ---
systemctl reset-failed {TUN_UNIT} 2>/dev/null || true
systemd-run --unit={TUN_UNIT} --collect --property=Restart=on-failure \\
    {t2s} -device {TUN_DEV} -proxy socks5://127.0.0.1:{socks} -interface {iface}
# --- DNS through the tunnel (back up the original once) ---
[ -f /etc/resolv.conf.xrbak ] || cp /etc/resolv.conf /etc/resolv.conf.xrbak 2>/dev/null || true
printf 'nameserver 1.1.1.1\\nnameserver 8.8.8.8\\n' > /etc/resolv.conf
"""
    with Spinner("configuring tun device + routes (sudo)"):
        rc = _run_root_script(script)
    if rc != 0:
        err("tun setup failed (see sudo/errors above)")
        return
    _ensure_dirs()
    with open(TUN_STATE_FILE, "w") as f:
        json.dump({"dev": TUN_DEV, "bypass": bypass, "iface": iface,
                   "gw": gw, "server": server["tag"]}, f, indent=2)
    time.sleep(0.5)
    if tun_active():
        ok(f"TUN mode {style('ON', GREEN, BOLD)} — whole system routed via "
           f"{style(server['tag'], BOLD)}")
        info("all apps now go through the tunnel; turn off with `xr tun off`")
    else:
        err("tun2socks did not come up — check `journalctl --user -u xray-cli-tun` "
            "or `sudo systemctl status xray-cli-tun`")


def _tun_off():
    if not shutil.which("ip"):
        warn("iproute2 not available")
        return
    st = load_tun_state()
    bypass = st.get("bypass", [])
    bypass_cmds = "\n".join(f"ip route del {ip}/32 2>/dev/null || true" for ip in bypass)
    script = f"""set +e
systemctl stop {TUN_UNIT} 2>/dev/null
systemctl reset-failed {TUN_UNIT} 2>/dev/null
ip route del 0.0.0.0/1 dev {TUN_DEV} 2>/dev/null
ip route del 128.0.0.0/1 dev {TUN_DEV} 2>/dev/null
{bypass_cmds}
ip link set dev {TUN_DEV} down 2>/dev/null
ip tuntap del mode tun dev {TUN_DEV} 2>/dev/null
if [ -f /etc/resolv.conf.xrbak ]; then mv -f /etc/resolv.conf.xrbak /etc/resolv.conf; fi
true
"""
    with Spinner("tearing down tun device + routes (sudo)"):
        _run_root_script(script)
    try:
        os.remove(TUN_STATE_FILE)
    except FileNotFoundError:
        pass
    ok(f"TUN mode {style('OFF', RED, BOLD)} — routing restored")


def cmd_logs(follow=False):
