class Spinner:
    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, text=""):
        self.text = text
        self._stop = threading.Event()
        self._t = None

    def __enter__(self):
        if _NO_COLOR:
            print(f"  {self.text}…")
            return self
        self._t = threading.Thread(target=self._spin, daemon=True)
        self._t.start()
        return self

    def _spin(self):
        i = 0
        while not self._stop.is_set():
            f = self.FRAMES[i % len(self.FRAMES)]
            sys.stdout.write(f"\r  {ORANGE}{f}{RESET} {self.text}…   ")
            sys.stdout.flush()
            i += 1
            time.sleep(0.08)

    def update(self, text):
        self.text = text

    def __exit__(self, *a):
        self._stop.set()
        if self._t:
            self._t.join()
        if not _NO_COLOR:
            sys.stdout.write("\r" + " " * (len(self.text) + 12) + "\r")
            sys.stdout.flush()


