SLASH = {
    "/add": "add a share link (vless/vmess/trojan/ss)",
    "/list": "list saved servers",
    "/ls": "list saved servers",
    "/use": "set active server  ·  /use <name|#>",
    "/start": "start the proxy service",
    "/stop": "stop the proxy service",
    "/restart": "restart the proxy service",
    "/status": "show connection status",
    "/test": "latency-test all servers",
    "/fastest": "test and switch to the fastest server",
    "/sub": "import a subscription URL  ·  /sub <url>",
    "/proxy": "system proxy  ·  /proxy on|off",
    "/remove": "delete a server  ·  /remove <name|#>",
    "/logs": "show service logs",
    "/config": "print generated xray config",
    "/help": "show this help",
    "/clear": "clear the screen",
    "/exit": "quit",
    "/quit": "quit",
}


def _banner():
    v = xray_version()
    vline = f"{GREEN}{v}{RESET}" if v else f"{RED}xray not installed{RESET}"
    print()
    print(box([
        f"{ORANGE}{BOLD}xray-cli{RESET}  {DIM}interactive shell{RESET}",
        "",
        f"{GRAY}core:{RESET} {vline}",
        f"{DIM}type {RESET}{CYAN}/help{RESET}{DIM} for commands, or paste a share link{RESET}",
    ], color=ORANGE))
    print()


def _status_line():
    state = load_state()
    active = state.get("active")
    running = service_active()
    dot = f"{GREEN}●{RESET}" if running else f"{DIM}○{RESET}"
    name = active or f"{DIM}no server{RESET}"
    conn = f"{GREEN}connected{RESET}" if running else f"{DIM}stopped{RESET}"
    return f"{dot} {name} {DIM}·{RESET} {conn}"


def _completer(servers):
    names = [s["tag"] for s in servers]

    def complete(text, state_idx):
        buf = _readline.get_line_buffer() if _readline else text
        if buf.startswith("/") and " " not in buf:
            opts = [c + " " for c in SLASH if c.startswith(text)]
        else:
            opts = [n for n in names if n.startswith(text)]
        return opts[state_idx] if state_idx < len(opts) else None
    return complete


try:
    import readline as _readline
except ImportError:
    _readline = None


def _print_help():
    rows = []
    seen = set()
    for cmd, desc in SLASH.items():
        if desc in seen:
            continue
        seen.add(desc)
        rows.append(f"{CYAN}{cmd:<10}{RESET} {DIM}{desc}{RESET}")
    print(box(rows, title="commands", color=PURPLE))


def repl():
    _banner()
    if _readline:
        _readline.set_completer_delims(" ")
        _readline.parse_and_bind("tab: complete")
    while True:
        if _readline:
            _readline.set_completer(_completer(load_servers()))
        try:
            print(f"\n  {_status_line()}")
            line = input(f"  {ORANGE}❯{RESET} ").strip()
        except (EOFError, KeyboardInterrupt):
            print(f"\n{DIM}  bye{RESET}\n")
            return
        if not line:
            continue
        if "://" in line and not line.startswith("/"):
            cmd_add(line.split())
            continue
        parts = line.split()
        cmd, args = parts[0], parts[1:]
        if not cmd.startswith("/"):
            cmd = "/" + cmd
        try:
            if cmd in ("/exit", "/quit"):
                print(f"{DIM}  bye{RESET}\n")
                return
            elif cmd == "/help":
                _print_help()
            elif cmd == "/clear":
                os.system("clear")
                _banner()
            elif cmd == "/add":
                cmd_add(args) if args else warn("usage: /add <link>")
            elif cmd in ("/list", "/ls"):
                cmd_list()
            elif cmd == "/use":
                cmd_use(args[0]) if args else warn("usage: /use <name|#>")
            elif cmd == "/remove":
                cmd_remove(args[0]) if args else warn("usage: /remove <name|#>")
            elif cmd == "/start":
                cmd_start()
            elif cmd == "/stop":
                cmd_stop()
            elif cmd == "/restart":
                cmd_restart()
            elif cmd == "/status":
                cmd_status()
            elif cmd == "/test":
                cmd_test(switch=False)
            elif cmd == "/fastest":
                cmd_test(switch=True)
            elif cmd == "/sub":
                cmd_sub(args[0]) if args else warn("usage: /sub <url>")
            elif cmd == "/proxy":
                cmd_proxy(args[0]) if args else warn("usage: /proxy on|off")
            elif cmd == "/logs":
                cmd_logs(follow=False)
            elif cmd == "/config":
                cmd_config()
            else:
                warn(f"unknown command {cmd} — try /help")
        except Exception as e:
            err(f"{type(e).__name__}: {e}")


